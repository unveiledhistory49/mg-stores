# Medusa backend connection (Store API)
# The storefront sends all requests to this URL with the publishable key below.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from Medusa Admin -> Settings -> Publishable API Keys.
# Required for product pricing, categories, regions and cart operations.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...